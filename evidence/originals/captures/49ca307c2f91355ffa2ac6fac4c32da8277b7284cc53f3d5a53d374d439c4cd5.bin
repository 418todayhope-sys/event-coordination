<script>
				 
				  
				  var button=document.createElement("button");
						button.id = "sui-webchat-btn";
						document.body.appendChild(button);
						document.body.insertBefore(button, document.body.firstElementChild);
						var iframe=document.createElement("iframe");
						iframe.id = "sui-webchat"
						document.body.appendChild(iframe);
						document.body.insertBefore(iframe, document.body.firstElementChild);
				 
					var showWebChat = false;
					var isMobile = false;
				 
					function updateButtonClasses() {
					  var button = document.querySelector('#sui-webchat-btn');
					  button.className = '';
					  if (showWebChat) {
						button.classList.add('show-iframe');
					  } else if (isMobile) {
						button.classList.add('show');
					  }
					}
				 
					function handleResize() {
					  var currentIsMobile = window.innerWidth <= 460;
					  if (currentIsMobile !== isMobile) {
						isMobile = currentIsMobile;
						assignClickHandlers();
					  }
					}
				 
					function assignClickHandlers() {
					  button.removeEventListener('click', handleClick);
					  button.removeEventListener('click', redirectToChat);
				 
					  if (isMobile) {
						button.addEventListener('click', redirectToChat);
					  } else {
						button.addEventListener('click', handleClick);
					  }
					}
				 
					function redirectToChat() {
					  window.location.href =
						'https://chat.seasalt.ai/chat/0873b6dd0468432ebd74d2ca2111301a?Channel=TICC_E';    /*ChatBot_E_Link **/
					}
				 
					var button = document.querySelector('#sui-webchat-btn');
					var iframe = document.querySelector('#sui-webchat');
				 
					var handleClick = function () {
					  if (
						iframe.src !==
						'https://chat.seasalt.ai/chat/0873b6dd0468432ebd74d2ca2111301a?Channel=TICC_E' /*ChatBot_E_Link **/
					  ) {
						iframe.src =
						  'https://chat.seasalt.ai/chat/0873b6dd0468432ebd74d2ca2111301a?Channel=TICC_E';  /*ChatBot_E_Link **/
					  }
					  iframe.style.display =
						iframe.style.display === 'block' ? 'none' : 'block';
					  showWebChat = !showWebChat;
					  updateButtonClasses();
					};
				 
					assignClickHandlers();
				 
					handleResize();
					window.addEventListener('resize', handleResize);
				 
				 
				 
				  </script>
